PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

REGISTRY_ONLY=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_business?schema=public

FIREBASE_PROJECT_ID=farmer-management-a5b32
FIREBASE_AUTH_DOMAIN=farmer-management-a5b32.firebaseapp.com
FIREBASE_STORAGE_BUCKET=farmer-management-a5b32.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=478192896115

# Local dev — path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# Production (Render / AWS) — use instead of file path
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or paste full JSON (single line):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional full mode — set REGISTRY_ONLY=false for platform/business routes
# SEED_PLATFORM_FIREBASE_UID=
# SEED_PLATFORM_EMAIL=platform@example.com
# SEED_PLATFORM_NAME=Platform Admin
